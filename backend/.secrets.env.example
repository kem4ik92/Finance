# Copy this file to `.secrets.env` and fill with real values.
# `.secrets.env` is in .gitignore — never commit real tokens.

# @BotFather → /newbot → отправит тебе строку вида 123456789:AAA...
TELEGRAM_BOT_TOKEN=

# HTTPS-URL твоего backend, без слэша в конце. Пример: https://api.my-finance.example
PUBLIC_BASE_URL=

# Опционально: ключ OpenRouter для кнопки «🤖 AI» в боте.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Опционально: куда класть SQLite-базу. По умолчанию — рядом с кодом.
# Для Docker/Fly.io рекомендуем /data/manat.db на смонтированном томе.
# MANAT_DB_PATH=/data/manat.db
